#!/usr/bin/env bash

# Unofficial Bash "strict mode"
# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -euo pipefail
#ORIGINAL_IFS=$IFS
IFS=$'\t\n' # Stricter IFS settings

# Order here by frequency of use
PATTERN_OPTIONS="urls files paths emails ipv4 ipv6"
ACTION_OPTIONS="copy open edit"

# Arguments, fall back on fzf menu if they are not provided
PATTERN="${1:-$(fzf --prompt="Select element to extract:" <<< "${PATTERN_OPTIONS// /$'\n'}")}"
ACTION="${2:-$(fzf --prompt="Select action:" <<< "${ACTION_OPTIONS// /$'\n'}")}"

error_exit() {
  printf "%s\n" "$1" 1>&2
  exit "${2:-1}" # default exit status 1
}

# Validate arguments
[[ " $PATTERN_OPTIONS " == *" $PATTERN "* ]] || error_exit "Unknown pattern: $PATTERN. Valid options: $PATTERN_OPTIONS"
[[ " $ACTION_OPTIONS " == *" $ACTION "* ]]   || error_exit "Unknown action: $ACTION. Valid options: $ACTION_OPTIONS"

action() {
  case "$ACTION" in
    "open")
      xargs -L 1 open
      # If this script runs inside a tmux popup this open command won't work
      # unless this script continues running
      sleep 1
      ;;
    "edit")
      # Need to fix "Vim: Warning: Input is not from a terminal" warning
      # message generated by this line
      xargs "$EDITOR"
      ;;
    "copy")
      pbcopy
      ;;
  esac
}

# Extract the specified elements by pattern
patterns -p "$PATTERN" |
  # Select one or more elements to operate on
  fzf --multi --bind 'ctrl-a:select-all,ctrl-d:deselect-all' |
  # Perform the specified operation on them
  action
